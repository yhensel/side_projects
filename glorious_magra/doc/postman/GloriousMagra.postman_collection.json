{
  "info": {
    "name": "GloriousMagra API",
    "description": "Postman collection for the GloriousMagra Symfony backend API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "measurementId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Get API health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "email", "value": "user@example.com" },
                { "key": "password", "value": "StrongPass123!" },
                { "key": "firstName", "value": "Alex" },
                { "key": "birthDate", "value": "1990-01-01" },
                { "key": "biologicalSex", "value": "male" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            }
          }
        },
        {
          "name": "Login user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "email", "value": "user@example.com" },
                { "key": "password", "value": "StrongPass123!" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "if (response && response.data && response.data.token) {",
                  "  pm.collectionVariables.set('token', response.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Measurements",
      "item": [
        {
          "name": "Create measurement",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "date", "value": "2026-07-30" },
                { "key": "weight", "value": "82.5" },
                { "key": "height", "value": "180" },
                { "key": "neck", "value": "38" },
                { "key": "waist", "value": "79" },
                { "key": "hip", "value": "95" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/measurements",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "measurements"
              ]
            }
          }
        },
        {
          "name": "List measurements",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/measurements?from=2026-01-01&to=2026-12-31",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "measurements"
              ],
              "query": [
                { "key": "from", "value": "2026-01-01" },
                { "key": "to", "value": "2026-12-31" }
              ]
            }
          }
        },
        {
          "name": "Get measurement detail",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/measurements/{{measurementId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "measurements",
                "{{measurementId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Groups",
      "item": [
        {
          "name": "Create group",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "name", "value": "Athletes Team" },
                { "key": "invitationCode", "value": "TEAM2026" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/groups",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "groups"
              ]
            }
          }
        },
        {
          "name": "Join group",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "invitationCode", "value": "TEAM2026" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/groups/join",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "groups",
                "join"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Activities",
      "item": [
        {
          "name": "List activities",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/activities",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "activities"
              ]
            }
          }
        }
      ]
    }
  ]
}
