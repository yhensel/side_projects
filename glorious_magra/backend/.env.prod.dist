# Copy this file to .env.local.php (compiled) or .env.prod.local on the OVH server.
# Never commit real secrets. Fill in actual values only on the server.

APP_ENV=prod
APP_DEBUG=0
APP_SECRET=REPLACE_WITH_A_NEW_RANDOM_SECRET

DEFAULT_URI=http://glorious-magra.yhensel.com

# Use the MySQL database and credentials provided by OVH Web Hosting.
DATABASE_URL="mysql://OVH_DB_USER:OVH_DB_PASSWORD@OVH_DB_HOST:3306/OVH_DB_NAME?serverVersion=8.0.32&charset=utf8mb4"

# Restrict to your real frontend origin(s) in production.
CORS_ALLOW_ORIGIN='^http://glorious-magra\.yhensel\.com$'

# Generate a new passphrase and keypair locally before FTP upload; never reuse the dev keys.
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=REPLACE_WITH_A_NEW_RANDOM_PASSPHRASE

# Messenger stays synchronous in production so no background worker is required.
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
